# Smart Operator Assistant — backend config example.
# Copy to backend/.env and fill in. NEVER commit backend/.env with a real key
# (.env is gitignored; the service-role key must live only here).

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# csv: read the generator's CSVs from DATA_DIR (local dev, no Supabase needed)
# supabase: read/write through the service-role client
DATA_SOURCE=csv

# Resolved against backend/ if relative
DATA_DIR=../data/output

# true: accept any bearer token (local dev). Set false for anything shared.
DEV_AUTH_BYPASS=true
