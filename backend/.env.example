SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role>
DATABASE_URL=postgresql://postgres.<ref>:<pw-url-encoded>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
LLM_API_KEY=<key>
# comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# shared bearer token for the vision service (vision/run.py reads it as VISION_API_TOKEN)
VISION_API_TOKEN=<long-random-string>
# optional: legacy HS256 JWT secret for local token checks (else JWKS / GET /auth/v1/user)
SUPABASE_JWT_SECRET=
# APScheduler jobs; set false to run the API without background jobs
SCHEDULER_ENABLED=true
