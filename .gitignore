# secrets
.env
.env.*
!.env.example

# generated data and model artifacts
data/output/*
!data/output/.gitkeep
# 1-day sample from generate.py --sample, shared for mocks
!data/output/sample/
# Model artifacts in ml/artifacts/<model>/ are committed (each model < 20 MB) so the backend
# needs no retraining. Anything larger goes elsewhere, not in git.

# backend: /chat answers added at runtime (backend/cache/demo.json is committed)
backend/cache/chat_runtime.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# vision: YOLO weights download on first run; calibration is per camera
vision/weights/
vision/calibration.json

# node / web
node_modules/
dist/

# supabase cli
supabase/.temp/
supabase/.branches/

# os / editors
.DS_Store
Thumbs.db
