# Copy to vision/.env. The vision service never talks to Supabase; it posts events to the backend.
# Same value as VISION_API_TOKEN in backend/.env; sent as `Authorization: Bearer <token>` on every call.
VISION_API_TOKEN=
# Optional defaults for run.py (CLI flags win): the demo persona OP02 on M05.
BACKEND_URL=http://localhost:8000
MACHINE_ID=M05
OPERATOR_ID=OP02
